{
  "name": "cubase-bfw-platformmplussd",
  "version": "4.1.0-rc1",
  "private": true,
  "description": "Cubase MIDI Remote for the Icon Platform M+ controller with StreamDeck",
  "scripts": {
    "build": "tsup",
    "build:dev": "tsup --env.BFW_DEBUG_LOGS true",
    "start": "tsup --watch",
    "start:dev": "tsup --watch --env.BFW_DEBUG_LOGS true",
    "tsc": "tsc",
    "test:jog": "node --test tests/jog.test.cjs",
    "test:midi-cc": "node --test tests/midi-cc.test.cjs",
    "test:logger": "node --test tests/logger.test.cjs",
    "postversion": "npm run build",
    "postinstall": "patch-package"
  },
  "author": "woodcockr",
  "license": "MIT",
  "dependencies": {
    "abbreviate": "0.0.3",
    "core-js": "3.37.0"
  },
  "devDependencies": {
    "@swc/core": "^1.3.0",
    "@types/node": "^20.12.8",
    "patch-package": "^8.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "prettier": {
    "printWidth": 100
  }
}
